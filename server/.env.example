# Copie este arquivo para .env e preencha. NUNCA versione o .env.

# Supabase (Project Settings → API Keys). A chave SECRETA nunca vai para o front.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=

# development | production
NODE_ENV=development
PORT=3001

# Segredo do JWT: mínimo 32 caracteres, aleatório. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Tempo de validade da sessão (ex.: 8h, 12h, 1d)
JWT_EXPIRES_IN=8h

# Domínios do front autorizados (separados por vírgula). Obrigatório em produção.
CORS_ORIGINS=http://localhost:5173

# Atrás de proxy/load balancer (Render, Railway, Nginx): número de proxies (geralmente 1)
TRUST_PROXY=

# Tamanho máximo da foto da maquininha, em MB (o front já comprime antes de enviar)
MAX_PHOTO_MB=2

# Sincronização com a API de franquias (ITF Gestor)
# FRANCHISE_API_URL=off            -> desliga o sync
# FRANCHISE_API_TOKEN=             -> se a API passar a exigir token Bearer
# FRANCHISE_SYNC_INTERVAL_MIN=15
# FRANCHISE_SYNC_MAX_INACTIVATE_PCT=10
